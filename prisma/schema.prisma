generator client {
  provider = "prisma-client-js"
  engineType = "binary"  # Força uso do binário
  binaryTargets = ["windows"] # Especifica apenas Windows
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}